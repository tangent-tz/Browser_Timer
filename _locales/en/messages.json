      "h": {
        "content": "$1",
        "example": "01"
      },
      "m": {
        "content": "$2",
        "example": "30"
      }
    }
  },
  "badgeMinutes": {
    "message": "$m$:$s$",
    "description": "Badge text format for minutes and seconds (max 4 chars)",
    "placeholders": {
      "m": {
        "content": "$1",
        "example": "05"
      },
      "s": {
        "content": "$2",
        "example": "30"
      }
    }
